{{!
    @template local_archiving/job_details

    Archive job details page, listing all archived objects.

    Example context (json):
    {
        "job": {
            "id": 1,
            "triggername": "Manual",
            "status": {
                "text": "Completed",
                "help": "The job has been completed.",
                "color": "success"
            },
            "metadata": [
                {"key": "foo", "humankey": "Foo value", "value": "bar"},
                {"key": "lorem", "humankey": "The Lorem Gauge", "value": "ipsum"}
            ],
            "timecreated": 1747836796,
            "timemodified": 1747836808
        },
        "contenttablehtml": "generated HTML for the job content table",
        "urls": {
            "back": "https://foo.bar.baz"
        }
    }
}}

<div class="container">
    <div class="row">
        <div class="col-12">
            <h1>{{#str}} archive_job_details, local_archiving {{/str}}</h1>
        </div>
    </div>
    <div class="row">
        <div class="col-6">
            {{> local_archiving/components/job_info }}
        </div>
        <div class="col-6">
            {{> local_archiving/components/job_metadata }}
        </div>
    </div>
    <div class="row">
        <div class="col-12">
            <h3>{{#str}} archive_contents, local_archiving {{/str}}</h3>
            <p>{{#str}} archive_contents_desc, local_archiving {{/str}}</p>
            {{{contenttablehtml}}}
        </div>
    </div>
    <div class="row">
        <div class="col-12 mt-3">
            <a href="{{{urls.back}}}" class="btn btn-secondary">{{#str}} back_to_overview, local_archiving {{/str}}</a>
        </div>
    </div>
</div>
