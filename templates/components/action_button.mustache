{{!
    @template local_archiving/components/action_button

    Generic action button that redirects the user to another page given its
    action URL. If no action URL is provided, the button is disabled.

    Example context (json):
    {
        "url": "http://127.0.0.1/local/archiving/job.php?id=123",
        "btnclass": "btn-primary",
        "label": "Details",
        "icon": "fa-magnifying-glass"
    }
}}

{{!
    We create a wrapper span around the button to ensure that the tooltip is
    displayed even when the button is disabled. Otherwise pointer events will be
    ignored by the browser.
}}
<span
    class="d-inline-block"
    data-toggle="tooltip"
    data-bs-toggle="tooltip"
    data-placement="top"
    data-bs-placement="top"
    title="{{label}}"
>
    <a
        role="button"
        title="{{label}}"
        aria-label="{{label}}"
        {{#url}}
            class="btn {{btnclass}} m-1"
            href="{{url}}"
        {{/url}}
        {{^url}}
            class="btn {{btnclass}} m-1 disabled"
            href="#"
            aria-disabled="true"
            tabindex="-1"
        {{/url}}
    >
        <i class="fa {{icon}}" aria-hidden="true"></i>
    </a>
</span>
