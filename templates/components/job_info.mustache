{{!
    @template local_archiving/components/job_info

    Table with general information about a single archive job.

    Example context (json):
    {
        "job": {
            "id": 1,
            "triggername": "Manual",
            "status": {
                "badge_text": "Running",
                "badge_color": "primary",
                "tooltip_text": "The job is currently ...",
                "progress": "42",
                "has_progress": true
            },
            "timecreated": 1747836796,
            "timemodified": 1747836808
        }
    }
}}

<table class="table">
    <tr>
        <td>{{#str}} jobid, local_archiving {{/str}}</td>
        <td>{{job.id}}</td>
    </tr>
    <tr>
        <td>{{#str}} trigger, local_archiving {{/str}}</td>
        <td>{{job.triggername}}</td>
    </tr>
    <tr>
        <td>{{#str}} status {{/str}}</td>
        <td>
            <div data-jobid="{{job.id}}" data-ref="status">
                {{#job.status}}
                    {{> local_archiving/components/job_status }}
                {{/job.status}}
            </div>
        </td>
    </tr>
    <tr>
        <td>{{#str}} timecreated {{/str}}</td>
        <td>
            {{#userdate}} {{job.timecreated}}, {{#str}} strftimedatetimeaccurate, core_langconfig {{/str}} {{/userdate}}
        </td>
    </tr>
    <tr>
        <td>{{#str}} lastmodified {{/str}}</td>
        <td>
            <div data-jobid="{{job.id}}" data-ref="timemodified">
                {{#userdate}} {{job.timemodified}}, {{#str}} strftimedatetimeaccurate, core_langconfig {{/str}} {{/userdate}}
            </div>
        </td>
    </tr>
</table>
