{{!
    @template local_archiving/components/job_metadata

    List of all metadata entries of a single archive job.

    Example context (json):
    {
        "job": {
            "metadata": [
                {"key": "foo", "humankey": "Foo value", "value": "bar"},
                {"key": "lorem", "humankey": "The Lorem Gauge", "value": "ipsum"}
            ]
        }
    }
}}

<ul class="list-group small">
    {{#job.metadata}}
        <li class="list-group-item">
            {{humankey}}
            <span class="badge badge-secondary">{{value}}</span>
        </li>
    {{/job.metadata}}
    {{^job.metadata}}
        <li class="list-group-item">
            <span class="text-muted">Nothing to show yet ...</span>
        </li>
    {{/job.metadata}}
</ul>
