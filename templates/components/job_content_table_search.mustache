{{!
    @template local_archiving/components/job_content_table_search

    Filter form for the job content table.

    Example context (json):
    {
        "uniqueid": "job_content_table_42",
        "contextid": 42,
        "actionurl": "https://example.com/local/archiving/job.php",
        "hiddenparams": [
            {"name": "id", "value": 7}
        ],
        "selecteduser": {"id": 3, "fullname": "Max Mustermann", "label": "<span>Max Mustermann <small>max@example.com</small></span>"},
        "filteractive": true,
        "reseturl": "https://example.com/local/archiving/job.php?id=7"
    }
}}
<form method="get" action="{{actionurl}}" class="d-flex flex-wrap align-items-center mb-3" role="search">
    {{! Keep all page parameters during submission }}
    {{#hiddenparams}}
        <input type="hidden" name="{{name}}" value="{{value}}">
    {{/hiddenparams}}

    {{! User filter autocomplete }}
    {{> local_archiving/components/user_search_field }}

    {{! Action buttons }}
    <button type="submit" class="btn btn-primary mr-2 me-2 mb-2">
        <i class="fa fa-search" aria-hidden="true"></i>
        {{#str}} search, moodle {{/str}}
    </button>

    {{#filteractive}}
        <a href="{{reseturl}}" class="btn btn-secondary mb-2">
            {{#str}} reset, moodle {{/str}}
        </a>
    {{/filteractive}}
</form>
